# AI Terminal (AIT) Configuration
# Copy this file to:
#   Linux: `$XDG_CONFIG_HOME` or `$HOME`/.config/ait/config.toml, e.g., /home/alice/.config/ait/config.toml
#   macOS: `$HOME`/Library/Application Support/ait, e.g., /Users/Alice/Library/Application Support/ait/config.toml
#   Windows: `{FOLDERID_RoamingAppData}\ait\config.toml`, e.g., C:\Users\Alice\AppData\Roaming\ait\config.toml

# Default Ollama host URL
# This is the base URL of your Ollama instance.
# Can also be overridden via the -o / --ollama-host CLI flag.
# Default: http://localhost:11434/
ollama_host = "http://localhost:11434/"

# Default system prompt used when no context is provided.
# Can also be overridden via the -s / --system-prompt CLI flag.
# Default: "You are a helpful, friendly assistant."
system_prompt = "You are a helpful, friendly assistant."

# Default model to use when the app starts.
# Can be changed in-app via the model selection menu.
# Default: {name = "gemini-3.1-pro-preview", provider = "Gemini"}
default_model = {name = "gemini-3.1-pro-preview", provider = "Gemini"}

# Default thinking level for new conversations.
# Valid values: none, low, medium, high, xhigh, max.
# Can be changed in-app from the thinking level selector.
# Default: medium
default_thinking_level = "medium"

# ──────────────────────────────────────────────────────────────────────────
# MCP (Model Context Protocol) servers
# ──────────────────────────────────────────────────────────────────────────
# Define one sub-table per server under [mcp.servers]. The table key is the
# server's stable id. Each server is either a stdio server (spawn a child
# process) or an http server (connect to a remote URL):
#
#   stdio  → set `command` (and optionally `args`, `env`)
#   http   → set `url`      (and optionally `api_key`, `headers`)
#
# Setting both `command` and `url` (or neither) is an error.
#
# `enabled` controls whether the server is connected automatically on startup.
# It defaults to `true` when omitted; set it to `false` to define a server but
# keep it disconnected until you toggle it on in-app (coming soon).
#
# `name` is an optional display name; it defaults to the server id.
#
# Secrets: for stdio servers pass them via `env`; for http servers use
# `api_key` (sent as `Authorization: Bearer <api_key>`) or a custom `headers`
# entry. Note that these values are stored in plaintext in this file.
#
# To avoid pasting secrets verbatim, reference environment variables with
# `${VAR}` (or `$VAR`) anywhere in a server config — they are expanded at
# connect time, so the on-disk file only ever holds the placeholder:
#
#   [mcp.servers.kagi]
#   command = "uvx"
#   args = ["kagimcp"]
#   env = { KAGI_API_KEY = "${KAGI_API_KEY}" }   # set KAGI_API_KEY in your shell
#
# Supported forms:
#   ${VAR}              → value of VAR (error if unset)
#   ${VAR:-default}     → value of VAR, or `default` if unset
#   $VAR                → value of VAR (error if unset)
#   $$                  → literal `$`
#
# Example — a stdio server (the official filesystem server):
#
#   [mcp.servers.filesystem]
#   name = "Filesystem"
#   enabled = true
#   command = "npx"
#   args = ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
#   env = {}
#
# Example — an http server with an API key:
#
#   [mcp.servers.weather]
#   name = "Weather"
#   enabled = true
#   url = "https://weather.example.com/mcp"
#   api_key = "your-secret-key"
#   headers = { "X-Custom-Header" = "value" }

